{
  "all": true,
  "reporter": [
    "lcov",
    "text-summary"
  ],
  "include": [
    "index.js",
    "system/**/*.js",
    "postinstall.js"
  ],
  "exclude": [
    "**/test/**",
    "node_modules/"
  ],
  "check-coverage": true,
  "lines": 95,
  "statements": 95,
  "functions": 95,
  "branches": 85
}
